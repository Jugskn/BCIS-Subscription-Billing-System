{
  "name": "bcis-subscription-billing-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "pnpm --parallel --filter @bcis/api --filter @bcis/desktop dev",
    "dev:api": "pnpm --filter @bcis/api dev",
    "dev:desktop": "pnpm --filter @bcis/desktop dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @bcis/db generate",
    "db:migrate": "pnpm --filter @bcis/db migrate",
    "db:seed": "pnpm --filter @bcis/api exec tsx src/scripts/seed.ts",
    "db:reset": "pnpm --filter @bcis/db exec tsx src/reset.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "test:acceptance": "pnpm --filter @bcis/api exec vitest run --config vitest.acceptance.config.ts",
    "test:concurrency": "pnpm --filter @bcis/api exec tsx src/scripts/concurrency.ts",
    "build:installer": "pnpm --filter @bcis/desktop build:installer"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
